{
  "extends": "./tsconfig.app.json",
  "include": [
    "src/**/__tests__/*",
    "src/**/*.test.ts",
    "env.d.ts",
    "supabase/functions/types.d.ts",
    "supabase/functions/_shared/**/*.ts",
    "supabase/functions/auth-token/**/*.ts",
    "supabase/functions/ai-coach/**/*.ts",
    "supabase/functions/delete-account/**/*.ts"
  ],
  "exclude": ["supabase/functions/**/*.deno.test.ts"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo",
    "allowImportingTsExtensions": true,

    "lib": ["ES2022"],
    "types": ["node", "jsdom"]
  }
}
